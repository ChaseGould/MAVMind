{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavmind.local/mission_schema.json",
  "title": "Mission proposal",
  "description": "A mission proposed by the LLM. Altitudes are metres relative to home. Item 0 (home) is added by the vehicle service, never proposed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "items"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "maxLength": 2000},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "lat": {"type": "number", "minimum": -90, "maximum": 90},
    "lon": {"type": "number", "minimum": -180, "maximum": 180},
    "alt_m": {"type": "number"},
    "item": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"type": "string"}
      },
      "oneOf": [
        {"$ref": "#/$defs/NAV_TAKEOFF"},
        {"$ref": "#/$defs/NAV_WAYPOINT"},
        {"$ref": "#/$defs/NAV_LOITER_TIME"},
        {"$ref": "#/$defs/NAV_LAND"},
        {"$ref": "#/$defs/NAV_RETURN_TO_LAUNCH"},
        {"$ref": "#/$defs/DO_CHANGE_SPEED"},
        {"$ref": "#/$defs/DO_SET_SERVO"},
        {"$ref": "#/$defs/DO_GRIPPER"},
        {"$ref": "#/$defs/DO_DIGICAM_CONTROL"}
      ]
    },
    "NAV_TAKEOFF": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "alt_m"],
      "properties": {
        "command": {"const": "NAV_TAKEOFF"},
        "alt_m": {"$ref": "#/$defs/alt_m"}
      }
    },
    "NAV_WAYPOINT": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "lat", "lon", "alt_m"],
      "properties": {
        "command": {"const": "NAV_WAYPOINT"},
        "lat": {"$ref": "#/$defs/lat"},
        "lon": {"$ref": "#/$defs/lon"},
        "alt_m": {"$ref": "#/$defs/alt_m"},
        "hold_s": {"type": "number", "minimum": 0, "maximum": 600}
      }
    },
    "NAV_LOITER_TIME": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "lat", "lon", "alt_m", "time_s"],
      "properties": {
        "command": {"const": "NAV_LOITER_TIME"},
        "lat": {"$ref": "#/$defs/lat"},
        "lon": {"$ref": "#/$defs/lon"},
        "alt_m": {"$ref": "#/$defs/alt_m"},
        "time_s": {"type": "number", "minimum": 0, "maximum": 3600}
      }
    },
    "NAV_LAND": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "Land at lat/lon, or at the current position when omitted.",
      "properties": {
        "command": {"const": "NAV_LAND"},
        "lat": {"$ref": "#/$defs/lat"},
        "lon": {"$ref": "#/$defs/lon"}
      },
      "dependentRequired": {"lat": ["lon"], "lon": ["lat"]}
    },
    "NAV_RETURN_TO_LAUNCH": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"const": "NAV_RETURN_TO_LAUNCH"}
      }
    },
    "DO_CHANGE_SPEED": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "speed_mps"],
      "properties": {
        "command": {"const": "DO_CHANGE_SPEED"},
        "speed_mps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "DO_SET_SERVO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "servo", "pwm"],
      "properties": {
        "command": {"const": "DO_SET_SERVO"},
        "servo": {"type": "integer", "minimum": 1, "maximum": 32},
        "pwm": {"type": "integer", "minimum": 800, "maximum": 2200}
      }
    },
    "DO_GRIPPER": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "action"],
      "properties": {
        "command": {"const": "DO_GRIPPER"},
        "gripper": {"type": "integer", "minimum": 1, "maximum": 8},
        "action": {"enum": ["release", "grab"]}
      }
    },
    "DO_DIGICAM_CONTROL": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"const": "DO_DIGICAM_CONTROL"}
      }
    }
  }
}
